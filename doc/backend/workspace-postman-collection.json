{
    "info": {
        "name": "WLMS - Workspace API",
        "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
    },
    "item": [
        {
            "name": "Create Workspace",
            "request": {
                "method": "POST",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{bearer_token}}"
                    },
                    { "key": "X-Idempotency-Key", "value": "{{$guid}}" }
                ],
                "url": {
                    "raw": "{{base_url}}/api/workspaces",
                    "host": ["{{base_url}}"],
                    "path": ["api", "workspaces"]
                },
                "body": {
                    "mode": "raw",
                    "raw": "{\n  \"name\": \"Engineering Workspace\",\n  \"description\": \"Main workspace for engineering group\"\n}",
                    "options": {
                        "raw": {
                            "language": "json"
                        }
                    }
                }
            }
        },
        {
            "name": "Get Workspaces",
            "request": {
                "method": "GET",
                "header": [
                    { "key": "Accept", "value": "application/json" },
                    {
                        "key": "Authorization",
                        "value": "Bearer {{bearer_token}}"
                    }
                ],
                "url": {
                    "raw": "{{base_url}}/api/workspaces?limit=50",
                    "host": ["{{base_url}}"],
                    "path": ["api", "workspaces"],
                    "query": [{ "key": "limit", "value": "50" }]
                }
            }
        }
    ]
}
